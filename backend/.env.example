FOOTBALL_API_KEY=your_api_key_here
FOOTBALL_API_URL=https://api.football-data.org/v4

# The-Odds-API (https://the-odds-api.com) — momios de casas de apuestas
# Tier gratuito: 500 requests/mes. Tier básico (~$10/mes): 10,000 req/mes.
ODDS_API_KEY=your_odds_api_key_here

# Peso del mercado en el blend de probabilidades (0=solo modelo, 1=solo mercado)
ODDS_BLEND_ALPHA=0.6
# Peso extra de mercado SOLO en la cuota de empate (alpha + boost, acotado a 1)
ODDS_DRAW_MARKET_BOOST=0.2
# Escala de paridad del empate: menor → más masa de empate en partidos
# desequilibrios (bajado 2.0→1.2 tras el backtest de jornada 1+2)
ODDS_DRAW_SCALE=1.2
# Damp de coasting (stakes-aware): afloja la victoria del favorito en partidos
# de grupo que ya tiene casi resueltos. 0.0 = APAGADO (default; sin efecto ni
# coste). Encender ~jornada 3 con un caso SECURED real para calibrar (~0.10-0.20)
STAKES_COAST_DAMP=0.0

# API-Football (RapidAPI) — para enriquecer jugadores de ligas no cubiertas por football-data.org
# Obtén tu clave en: https://dashboard.api-football.com/register (portal directo, sin RapidAPI)
# Plan gratuito: 100 req/día · 10 req/min
APIF_KEY=your_api_football_key_here
